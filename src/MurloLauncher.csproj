<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AssemblyName>MurloVille</AssemblyName>
    <RootNamespace>MurloLauncher</RootNamespace>

    <!-- Самодостаточный один файл: игроку не нужно ставить .NET.
         Весит больше, зато запускается у всех без вопросов. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- В инвариантном режиме .NET 8+ по умолчанию не даёт создать никакую
         культуру, кроме инвариантной, а WPF при отрисовке числа в списке
         («Потоков» в настройках) просит en-US — и лаунчер падал по кнопке
         «Настройки» (владелец 12.10). Так культуры создаются (с инвариантными
         данными), а разбор чисел и дат остаётся прежним. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>

    <Version>1.5.3</Version>
    <Product>MurloVille</Product>
    <Company>MurloVille</Company>
    <AssemblyTitle>Лаунчер MurloVille</AssemblyTitle>
    <ApplicationIcon>assets\murlo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- Картинок внутри нет намеренно: оформление подгружается с сервера при
       запуске. Исходники открыты, а класть в открытый репозиторий чужую
       графику нельзя. Побочная выгода — вид меняется без пересборки. -->

</Project>
