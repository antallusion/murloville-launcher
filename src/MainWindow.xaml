<Window x:Class="MurloLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MurloVille" Height="560" Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource Ink}"
        MouseLeftButtonDown="Window_Drag">

    <Grid>
        <!-- Подложка приезжает с сервера при запуске, внутри программы её нет.
             Затемняем градиентом, иначе текст по картинке не читается: она
             яркая в середине. Если сервер недоступен, окно останется просто
             тёмным и это не мешает ничему. -->
        <Image x:Name="BgImage" Stretch="UniformToFill"/>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EE07090F" Offset="0.0"/>
                    <GradientStop Color="#B807090F" Offset="0.45"/>
                    <GradientStop Color="#5507090F" Offset="1.0"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Height="120" VerticalAlignment="Bottom">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0007090F" Offset="0"/>
                    <GradientStop Color="#F207090F" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Золотая нить сверху, как на сайте. -->
        <Rectangle Height="3" VerticalAlignment="Top">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#E6C36A" Offset="0.5"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Крестик закрытия. -->
        <Button x:Name="CloseBtn" Content="✕" Click="Close_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,14,0" Width="28" Height="28"
                Foreground="#8E8A82" FontSize="14" Cursor="Hand"
                Background="Transparent" BorderThickness="0"/>

        <Grid Margin="46,40,46,34">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Image x:Name="MarkImage" Width="76" Height="62" VerticalAlignment="Center"/>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MURLOVILLE" FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource Gold}"/>
                    <TextBlock Text="Wrath of the Lich King · 3.3.5a · боты-компаньоны"
                               FontSize="13" Foreground="{StaticResource TextMuted}"
                               Margin="2,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Середина: состояние сервера, папка игры и автозапуск -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Width="470"
                        HorizontalAlignment="Left">
                <TextBlock x:Name="OnlineText" Text=""
                           FontSize="15" Foreground="{StaticResource Text}"
                           TextWrapping="Wrap"/>

                <!-- Путь к игре можно вписать руками, выбрать в проводнике или
                     поручить поиску. Три пути к одному и тому же, потому что
                     папка у всех лежит по-разному. -->
                <TextBlock Text="ПАПКА С ИГРОЙ" FontSize="11" Margin="0,28,0,7"
                           Foreground="{StaticResource TextMuted}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0"
                             Style="{StaticResource PathInput}"
                             KeyDown="PathBox_KeyDown" LostFocus="PathBox_LostFocus"/>
                    <Button x:Name="BrowseBtn" Grid.Column="1" Content="ОБЗОР"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            Click="Browse_Click"/>
                    <Button x:Name="ScanBtn" Grid.Column="2" Content="НАЙТИ"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            Click="Scan_Click"/>
                </Grid>
                <TextBlock x:Name="PathHint" Text="" FontSize="11" Margin="2,7,0,0"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>

                <!-- Главное правило, видимое всегда. Стоит у поля пути, потому
                     что ошибаются именно здесь: указывают клиент другого
                     сервера, и наши таблицы рас поверх чужих моделей дают
                     невидимых персонажей (форум t/64). Если человек всё же
                     оставил чужую папку как есть, плашка краснеет и говорит,
                     как это исправить. -->
                <Border x:Name="ClientNoteBox" Margin="0,12,0,0" Padding="10,6,8,7"
                        BorderThickness="2,0,0,0" BorderBrush="#99E6C36A" Background="#14E6C36A">
                    <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="#D6CDB8">
                        <Run x:Name="ClientNoteHead" FontWeight="SemiBold" Foreground="{StaticResource Gold}"
                             Text="Играть можно только нашим клиентом."/>
                        <Run x:Name="ClientNoteBody"
                             Text="Пустую папку лаунчер заполнит сам, чистый 3.3.5a доведёт до нашего. Клиент другого сервера не указывай: поверх него персонажи становятся невидимыми."/>
                    </TextBlock>
                </Border>

                <!-- Ряд служебных кнопок: проверить обновления, пересчитать
                     файлы игры, показать настройки загрузки. -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="RefreshBtn" Content="ОБНОВЛЕНИЯ"
                            Style="{StaticResource SmallButton}" Click="Refresh_Click"/>
                    <Button x:Name="VerifyBtn" Content="ПРОВЕРИТЬ ФАЙЛЫ"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            Click="Verify_Click"/>
                    <Button x:Name="OptionsBtn" Content="НАСТРОЙКИ"
                            Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                            Click="Options_Click"/>
                </StackPanel>

                <StackPanel x:Name="OptionsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Скорость, МБ/с" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}"/>
                        <TextBox x:Name="SpeedBox" Grid.Column="1" Width="62" Margin="10,0,0,0"
                                 Style="{StaticResource PathInput}"
                                 LostFocus="Speed_Changed" KeyDown="Speed_Key"/>
                        <TextBlock Grid.Column="2" Text="Потоков" FontSize="12" Margin="22,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMuted}"/>
                        <ComboBox x:Name="ParallelBox" Grid.Column="3" Width="58" Margin="10,0,0,0"
                                  SelectionChanged="Parallel_Changed"/>
                    </Grid>
                    <CheckBox x:Name="StockBox" Margin="0,12,0,0"
                              Style="{StaticResource GoldCheck}"
                              Content="Сверять и стоковые файлы Blizzard"
                              Click="Stock_Click"/>
                    <TextBlock Text="Ноль в скорости — без ограничения. Стоковые архивы у готовой игры сверять незачем: они не меняются."
                               FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMuted}"/>
                </StackPanel>

                <CheckBox x:Name="AutoStartBox" Margin="0,18,0,0"
                          Style="{StaticResource GoldCheck}"
                          Content="Запускать вместе с Windows"
                          Click="AutoStart_Click"/>
                <TextBlock x:Name="SetupText" Text="" FontSize="11" Margin="27,7,0,0"
                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Низ: состояние, полоска, кнопка -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock x:Name="StatusText" Text="Проверяю обновления…"
                               FontSize="14" Foreground="{StaticResource Text}"
                               Margin="0,0,0,10"/>
                    <ProgressBar x:Name="Bar" Style="{StaticResource ThinBar}"
                                 Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="DetailText" Text=""
                               FontSize="11" Foreground="{StaticResource TextMuted}"
                               Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PlayBtn" Content="ИГРАТЬ"
                            Style="{StaticResource GoldButton}"
                            Width="210" Height="58" IsEnabled="False"
                            Click="Play_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
