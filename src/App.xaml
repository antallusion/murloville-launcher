<!-- StartupUri тут нет намеренно: окно создаёт App.xaml.cs, потому что при
     удалении открывать его не надо вовсе, а при автозапуске оно должно
     появиться свёрнутым. Разбор ключей командной строки лежит там же. -->
<Application x:Class="MurloLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- Цвета сайта: тёмный камень и золото. -->
        <SolidColorBrush x:Key="Gold"      Color="#E6C36A"/>
        <SolidColorBrush x:Key="GoldDim"   Color="#C8A45A"/>
        <SolidColorBrush x:Key="Ink"       Color="#07090F"/>
        <SolidColorBrush x:Key="Text"      Color="#EFE7D6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E8A82"/>

        <!-- Крупная кнопка «Играть». Плоская, золотая, с потемнением по
             наведению — как на сайте. -->
        <Style x:Key="GoldButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1A1408"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="{StaticResource Gold}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F2D488"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#4A4335"/>
                                <Setter Property="Foreground" Value="#8E8A82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Второстепенная кнопка: та же форма, но контуром. Рядом с золотой
             она не спорит за внимание, а спокойно предлагает второй путь. -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="4" Background="#22FFFFFF"
                                BorderBrush="#55E6C36A" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#99E6C36A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Полоска загрузки: тонкая, золотая, без объёма. -->
        <Style x:Key="ThinBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Маленькая кнопка рядом с полем пути: «Обзор» и «Найти». -->
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- Поле пути к игре. Его можно и вписать руками: не у всех папка
             лежит там, где её ищет поиск. -->
        <Style x:Key="PathInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Gold}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource GoldDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="4" Background="#22000000"
                                BorderBrush="#44E6C36A" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Галочка. Своя, потому что системная в тёмном окне выглядит чужой. -->
        <Style x:Key="GoldCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="17" Height="17" CornerRadius="3"
                                    Background="#22000000" BorderBrush="#66E6C36A" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 2,7 L 6,11 L 13,3"
                                      Stroke="{StaticResource Gold}" StrokeThickness="2"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
